# ---------------------------------------------------------------------------
# Firebase client (exposto ao browser — use APENAS dados públicos do projeto)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# ---------------------------------------------------------------------------
# Firebase Admin (server-side — NUNCA prefixar com NEXT_PUBLIC_)
# A chave privada aceita `\n` literal; o código normaliza para quebra de linha.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Administrador único (autorização): somente este e-mail acessa /admin
# ---------------------------------------------------------------------------
ADMIN_EMAIL=

# ---------------------------------------------------------------------------
# Profissional único da v1 (PRD RN-10/RN-11): configurado fora da interface
# administrativa e NUNCA enviado pelo formulário público de solicitação.
# A fonte de leitura é o documento `configuracoes/profissional`; esta variável é
# a SEMENTE de implantação, gravada nele na primeira leitura quando ainda não
# existe. Depois disso, alterar o valor aqui não muda o profissional configurado.
# ---------------------------------------------------------------------------
PROFISSIONAL_UNICO_NOME=

# ---------------------------------------------------------------------------
# Google Calendar (OAuth 2.0 server-side)
# Cadastre GOOGLE_CALENDAR_REDIRECT_URI como URI autorizada no Google Cloud.
# Gere GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY com: openssl rand -base64 32
# ---------------------------------------------------------------------------
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/admin/integracoes/google-calendar/callback
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=
# Duração padrão do atendimento no evento (opcional; padrão: 60).
GOOGLE_CALENDAR_EVENT_DURATION_MINUTES=60

# ---------------------------------------------------------------------------
# Emuladores (opcional, apenas desenvolvimento/testes de integração)
# Quando definidos, o Admin SDK inicializa sem credenciais de serviço.
# ---------------------------------------------------------------------------
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
